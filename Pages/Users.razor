
@page "/users"
@using System.Net.Http.Json
@using BlazorUsersJsonPlaceHolderApi.Models
@inject HttpClient Http

<PageTitle>Usuários</PageTitle>

<h1>Primeiro usuário da API</h1>

@if (usuario is null)
{
    <p>Carregando usuário...</p>
}
else
{
    <p>Nome: @usuario.Name</p>
    <p>Cidade: @usuario.Address?.City</p>
    <p>Empresa: @usuario.Company?.Name</p>
}

@code {
    private User? usuario;

    protected override async Task OnInitializedAsync()
    {
        var usuarios = await Http.GetFromJsonAsync<List<User>>("users");

        usuario = usuarios?.FirstOrDefault();

        if (usuario is not null)
        {
            Console.WriteLine($"Nome: {usuario.Name}");
            Console.WriteLine($"Cidade: {usuario.Address?.City}");
            Console.WriteLine($"Empresa: {usuario.Company?.Name}");
        }
    }
}
